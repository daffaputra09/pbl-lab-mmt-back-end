{
    "name": "fathzyya/backend-php",
    "description": "REST API PHP Native",
    "require": {
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "zircote/swagger-php": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "config/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "php bin/generate-openapi.php"
        ],
        "generate-openapi": "php bin/generate-openapi.php"
    }
}